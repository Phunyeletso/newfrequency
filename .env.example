# Website and app share one Supabase project. Copy to ignored .env.local.
# Copy the corresponding EXPO_PUBLIC_SUPABASE_* values from newFrequency/.env.
# Only public anon/publishable keys belong in VITE variables.
# Optional complete override; builds otherwise use the bundled shared app public configuration.
VITE_APP_SUPABASE_URL=
VITE_APP_SUPABASE_ANON_KEY=

# Forms default to the app Supabase URL and key above.
# Optional legacy overrides, using the same project REST URL and public key.
VITE_FEEDBACK_API_BASE=
VITE_FEEDBACK_ANON_KEY=

# Server-only Android artifact. Never prefix this URL with VITE_.
ANDROID_APK_URL=
ANDROID_APP_VERSION=
VITE_ANDROID_APP_VERSION=
VITE_IOS_TESTFLIGHT_LIVE=false
VITE_IOS_TESTFLIGHT_URL=

VITE_COMPANY_LEGAL_NAME=
VITE_SUPPORT_EMAIL=

# Payment credentials live in Supabase Edge Function secrets, NOT this browser
# configuration. See HANDOVER.md for deployed RPCs, functions and server flags.
