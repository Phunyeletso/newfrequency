# Copy to .env.local and fill in. Never commit the filled-in file.
#
# Everything here is optional in the sense that the site builds and runs
# without it — unset values render as an honest "not available yet" state
# rather than a broken link or a silently failing form.

# --- Existing feedback storage ---------------------------------------------
# supabase/setup.sql currently defines these write-only tables in the existing
# app Supabase project. Use that project's REST URL and public anon key. RLS
# must allow anonymous INSERT only; never add a browser SELECT policy.
# Base REST URL, no trailing slash. The table name is appended to it.
VITE_FEEDBACK_API_BASE=https://YOUR-APP-PROJECT.supabase.co/rest/v1
# Public anon/publishable key; RLS is the security boundary, not key secrecy.
VITE_FEEDBACK_ANON_KEY=

# --- Download links ---------------------------------------------------------
# Set these in Vercel's server environment after a successful EAS release.
# The download endpoint checks the artifact before redirecting; it fails closed
# if the link expires or stops serving an APK.
ANDROID_APK_URL=
ANDROID_APP_VERSION=
# Optional UI label only. Keep it aligned with ANDROID_APP_VERSION.
VITE_ANDROID_APP_VERSION=
# Set to true only once TestFlight is actually live for external testers.
VITE_IOS_TESTFLIGHT_LIVE=false
VITE_IOS_TESTFLIGHT_URL=

# --- Existing newFrequency app authentication ------------------------------
# These are the app Supabase project URL and publishable/anon key. The anon key
# is public by design and must remain protected by the app's RLS policies.
# Never put the service_role key in a VITE_ variable or website environment.
VITE_APP_SUPABASE_URL=
VITE_APP_SUPABASE_ANON_KEY=

# No investment offering or investor ledger is active. Do not enable this flag
# until legal terms, provider verification, server ledger and access controls
# have all been reviewed and released.
VITE_INVESTMENTS_ENABLED=false

# --- Legal details (privacy policy + terms) ---------------------------------
# Defaults to "New Frequency" if unset.
VITE_COMPANY_LEGAL_NAME=
# Until this is set, the privacy policy and terms point people at the feedback
# form instead of an email address. Set it as soon as you have one.
VITE_SUPPORT_EMAIL=
